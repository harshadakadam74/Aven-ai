# Copy to .env and edit. Never commit .env. Values below are placeholders.
AVEN_AI_ENV=development
AVEN_AI_HOST=127.0.0.1
AVEN_AI_PORT=8000
DATABASE_URL=sqlite:///./aven_ai.db

# Required to run the backend API (Android connects with this). Generate one:
#   python scripts/generate_key.py
AVEN_AI_API_KEY=

# Folders Aven may open ("open my <name> project/folder"), separated by ';' on Windows.
AVEN_AI_APPROVED_DIRS=
# Extra apps Aven may launch: name=full\path\to\app.exe;name2=...
AVEN_AI_EXTRA_APPS=
# Ask "yes/no" before opening anything (true/false)
AVEN_AI_CONFIRM_ACTIONS=false
# Save conversation history locally (true/false)
AVEN_AI_STORE_HISTORY=true
AVEN_AI_LOG_LEVEL=INFO
AVEN_AI_RATE_LIMIT_PER_MINUTE=60

# Optional OpenAI-compatible chat provider. Unknown requests use the offline fallback
# until both AI_PROVIDER=openai and AI_API_KEY are configured.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=20
